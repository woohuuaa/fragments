{
  "name": "fragments",
  "private": true,
  "version": "0.7.2",
  "description": "Fragments back-end API",
  "scripts": {
    "test:watch": "jest -c jest.config.js --runInBand --watch --",
    "test": "jest -c jest.config.js --runInBand --",
    "coverage": "jest -c jest.config.js --runInBand --coverage",
    "lint": "eslint \"./src/**/*.js\" \"tests/**/*.js\"",
    "start": "node src/index.js",
    "dev": "node --env-file=.env.debug --watch src/index.js",
    "debug": "node --env-file=.env.debug --inspect=0.0.0.0:9229 --watch src/index.js",
    "test:integration": "hurl --test --file-root tests/fixtures --glob \"tests/integration/**/*.hurl\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woohuuaa/fragments.git"
  },
  "author": "Wan Hua Wu",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@orangeopensource/hurl": "^8.0.4",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "3.8.3",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1099.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/lib-dynamodb": "^3.1099.0",
    "aws-jwt-verify": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-auth": "^4.2.1",
    "http-auth-passport": "^1.0.7",
    "markdown-it": "^14.2.0",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "stoppable": "^1.1.0"
  }
}
